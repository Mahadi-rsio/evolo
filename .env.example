# Evolo CLI – Environment Variables
# Copy this file to .env and fill in your values.

# Base URL for the Evolo API server (default: https://api.evolo.dev)
EVOLO_API_URL=https://api.evolo.dev

# Base URL for the authentication server (default: https://cloudisy.vercel.app)
EVOLO_AUTH_URL=https://cloudisy.vercel.app

# OAuth device-flow client ID (default: demo-cli)
EVOLO_CLIENT_ID=demo-cli
